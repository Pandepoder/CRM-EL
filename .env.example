# Private server-side variables. Never expose these to the browser.
DATABASE_URL=postgres://tonala:tonala_dev_password@localhost:54329/tonala_os
POSTGRES_HOST=localhost
POSTGRES_PORT=54329
POSTGRES_DB=tonala_os
POSTGRES_USER=tonala
POSTGRES_PASSWORD=tonala_dev_password

# Public variables. Only NEXT_PUBLIC_* values may be read by browser code.
NEXT_PUBLIC_APP_NAME=Tonala OS
NEXT_PUBLIC_APP_ENV=local

# Web session (min 32 characters). Required for apps/web login.
SESSION_SECRET=local-dev-change-me-to-at-least-32-characters-long

# Set to true to allow POST /api/auth/register outside local/test.
ALLOW_PUBLIC_REGISTRATION=false

# Contraseña para los usuarios demo generados por pnpm db:seed.
# Se hashea con argon2id y se guarda por usuario en user_profiles.password_hash.
# Cambiar esto en staging/producción y correr pnpm db:seed de nuevo.
DEMO_PASSWORD=TonalaDemo2026
