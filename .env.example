# ==============================================================================
# CRM-EL / Tonala OS - Environment Configuration Template
# Copy this file to .env for local development, or .env.production for deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# En entorno local con Docker usa: postgres://tonala:tonala_dev_password@localhost:54329/tonala_os
# En servidor de producción/VPS usa tu usuario, contraseña y host seguro:
DATABASE_URL=postgres://tonala:tonala_dev_password@localhost:54329/tonala_os
POSTGRES_HOST=localhost
POSTGRES_PORT=54329
POSTGRES_DB=tonala_os
POSTGRES_USER=tonala
POSTGRES_PASSWORD=tonala_dev_password

# ------------------------------------------------------------------------------
# 2. Seguridad de Sesiones y Autenticación (AES-256-GCM / iron-session)
# ------------------------------------------------------------------------------
# Clave secreta para cifrar cookies de sesión (OBLIGATORIO: Mínimo 32 caracteres aleatorios).
# Puedes generar uno en terminal con: openssl rand -base64 32
SESSION_SECRET=local-dev-change-me-to-at-least-32-characters-long-secret-key

# Clave AES-256 para cifrar datos personales y PII en PostgreSQL (OBLIGATORIO: Exactamente 32 caracteres).
# Puedes generar uno con: openssl rand -hex 16
DATABASE_ENCRYPTION_KEY=12345678901234567890123456789012

# Permitir registro público en /register (false en producción para estricto control de acceso)
ALLOW_PUBLIC_REGISTRATION=false

# ------------------------------------------------------------------------------
# 3. Configuración de Usuarios Iniciales
# ------------------------------------------------------------------------------
# Correo y contraseña para la cuenta Administrador Maestro al ejecutar `pnpm db:clean`:
ADMIN_EMAIL=admin@tonala.gob.mx
ADMIN_PASSWORD=CambiarEstaContrasenaSegura2026!

# Contraseña para usuarios de prueba en desarrollo local (`pnpm db:seed`):
DEMO_PASSWORD=TonalaDemo2026

# Habilitar botones de acceso rápido de prueba en /login (SOLO true en desarrollo local, false en producción)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# ------------------------------------------------------------------------------
# 4. Variables Públicas de la Aplicación
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Tonala OS - CRM Territorial"
NEXT_PUBLIC_APP_ENV=production
NODE_ENV=production
