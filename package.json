{
  "name": "tonala-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:start": "docker compose up -d db && tsx scripts/db/wait-for-db.ts",
    "db:status": "tsx scripts/db/status.ts",
    "db:stop": "docker compose down",
    "db:wait": "tsx scripts/db/wait-for-db.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-module-boundaries.mjs",
    "outbox:run-once": "tsx scripts/outbox/run-once.ts",
    "web:dev": "pnpm --filter @tonala/web dev",
    "web:build": "pnpm --filter @tonala/web build",
    "web:dev:legacy": "tsx scripts/web/dev-server.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/integration/**/*.test.ts --exclude packages/shared/database/database.test.ts",
    "test:integration": "vitest run tests/integration/**/*.test.ts packages/shared/database/database.test.ts",
    "test:watch": "vitest",
    "validate": "tsc --noEmit && tsc --noEmit -p apps/web && eslint . && node scripts/check-module-boundaries.mjs && vitest run",
    "validate:unit": "tsc --noEmit && tsc --noEmit -p apps/web && eslint . && node scripts/check-module-boundaries.mjs && vitest run --exclude tests/integration/**/*.test.ts --exclude packages/shared/database/database.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.32.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}

