# ==============================================================================
# CRM-EL / Tonala OS - Plantilla de entorno de PRODUCCIÓN (Docker + Caddy)
# Copia este archivo a ".env" en tu servidor (NO ".env.production" — Docker
# Compose solo lee variables de un archivo llamado exactamente ".env").
#   cp .env.production.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de datos PostgreSQL (host "db" = nombre del servicio en docker-compose)
# ------------------------------------------------------------------------------
# Genera una contraseña real con: openssl rand -base64 24
POSTGRES_USER=tonala
POSTGRES_PASSWORD=REEMPLAZA_ESTA_CONTRASENA
POSTGRES_DB=tonala_os
DATABASE_URL="postgres://tonala:REEMPLAZA_ESTA_CONTRASENA@db:5432/tonala_os"

# ------------------------------------------------------------------------------
# 2. Seguridad de sesiones y cifrado de PII (OBLIGATORIOS, sin valor por defecto)
# ------------------------------------------------------------------------------
# Cookies de sesión (iron-session). Mínimo 32 caracteres. Genera con:
#   openssl rand -base64 32
SESSION_SECRET=REEMPLAZA_CON_openssl_rand_-base64_32

# Cifrado AES-256 de datos personales (CURP, teléfono, domicilio, etc.) en
# PostgreSQL. Exactamente 32 caracteres. Genera con:
#   openssl rand -hex 16
# La app se niega a arrancar si dejas el valor de ejemplo de .env.example.
DATABASE_ENCRYPTION_KEY=REEMPLAZA_CON_openssl_rand_-hex_16

# ------------------------------------------------------------------------------
# 3. Cuenta de Administrador Maestro (creada al correr `pnpm db:clean`)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=REEMPLAZA_CON_UNA_CONTRASENA_SEGURA

# DEMO_PASSWORD no va en producción. `pnpm db:clean` ya NO la acepta como respaldo
# de ADMIN_PASSWORD: aceptarla significaba crear al administrador real con una
# contraseña de demostración. Si la defines aquí y coincide con ADMIN_PASSWORD,
# `pnpm db:clean` aborta.
# DEMO_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Control de acceso público
# ------------------------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
# Debe quedar vacía: sin ella el login demo no se compila aunque el flag se active.
NEXT_PUBLIC_DEMO_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Variables públicas de la aplicación
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Tonala OS - CRM Territorial"
NEXT_PUBLIC_APP_ENV=production
NODE_ENV=production

# ------------------------------------------------------------------------------
# 6. Dominio (usado por el Caddyfile para emitir el certificado HTTPS)
# ------------------------------------------------------------------------------
# Reemplaza por tu dominio real apuntando a este servidor.
DOMAIN=midominio.com
